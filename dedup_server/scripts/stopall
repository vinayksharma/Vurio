#!/bin/bash

# stopall - Stop all instances of the Media Deduplication Server
# This script finds and terminates all running instances of media_dedup_server

set -e

echo "Stopping all Media Deduplication Server instances..."

APP_DIR="$(cd "$(dirname "$0")/../.." && pwd)"

# Find all processes matching media_dedup_server
PIDS=$(pgrep -f media_dedup_server 2>/dev/null || true)

# Stop frontend processes
echo "Stopping frontends..."
pkill -f "electron.*${APP_DIR}" 2>/dev/null || true
pkill -f "electron.*vurio" 2>/dev/null || true
pkill -f "electron.*main.js" 2>/dev/null || true
pkill -f "VURIO" 2>/dev/null || true

if [ -z "$PIDS" ]; then
    echo "No Media Deduplication Server instances found running."
    exit 0
fi

echo "Found Media Deduplication Server instances with PIDs: $PIDS"

# Send SIGTERM first for graceful shutdown
echo "Sending SIGTERM for graceful shutdown..."
for pid in $PIDS; do
    if kill -0 "$pid" 2>/dev/null; then
        echo "  Sending SIGTERM to PID $pid"
        kill -TERM "$pid" 2>/dev/null || true
    fi
done

# Wait a moment for graceful shutdown
sleep 2

# Check if any processes are still running
REMAINING_PIDS=$(pgrep -f media_dedup_server 2>/dev/null || true)

if [ -n "$REMAINING_PIDS" ]; then
    echo "Some processes still running, sending SIGKILL..."
    for pid in $REMAINING_PIDS; do
        if kill -0 "$pid" 2>/dev/null; then
            echo "  Sending SIGKILL to PID $pid"
            kill -KILL "$pid" 2>/dev/null || true
        fi
    done
    
    # Final check
    sleep 1
    FINAL_PIDS=$(pgrep -f media_dedup_server 2>/dev/null || true)
    if [ -n "$FINAL_PIDS" ]; then
        echo "Warning: Some processes may still be running: $FINAL_PIDS"
        exit 1
    fi
fi

# Sweep orphaned media subprocesses. The server enforces per-subprocess
# timeouts only while it is alive; a server killed mid-processing orphans its
# in-flight transcode/thumbnail children to PID 1, and a child wedged on a
# vanished input (e.g. an SMB read cut mid-transcode) spins at 100% CPU
# forever. Their argv always carries one of our app-specific markers
# (temp-output names, or the exif probe's -define token), so these patterns
# cannot match unrelated processes. Keep the list in sync with
# scripts/run.sh and src/utils/orphan_sweeper.cpp.
for pattern in magick_out_ heic_out_ thumb_out_ raw_embedded_ fullres_ exif_probe_; do
    if pkill -9 -f "$pattern" 2>/dev/null; then
        echo "Killed orphaned media subprocess(es) matching '$pattern'"
    fi
done

echo "All Media Deduplication Server instances stopped successfully."
