{
  "_readme": [
    "Vocabulary for the EXIF query parser (natural-language photo search).",
    "Edit this file to teach the parser new words — no rebuild needed,",
    "changes apply on server restart. All entries must be lowercase;",
    "multi-word phrases are allowed and match across any whitespace.",
    "A list present here REPLACES the built-in default list wholesale;",
    "a list you delete falls back to the built-in defaults.",
    "The query GRAMMAR (shapes like 'iso above N', 'f/2.8', '1/500',",
    "4-digit years) is fixed in code — this file only supplies the words",
    "those patterns alternate over. Symbols are ordinary words here:",
    "'>' and '<=' sit in the comparison lists like 'above' and 'at most'.",
    "A comparator may be followed by an optional 'than', and the numeric",
    "dimensions accept a spelled-out name ('aperture', 'f-stop', 'focal",
    "length') in front of it. Path is configurable via the",
    "'search.keywordsPath' setting (default: config/exif_search_keywords.json)."
  ],

  "camera": {
    "brands": [
      "canon", "nikon", "sony", "fuji", "fujifilm", "panasonic", "lumix",
      "olympus", "leica", "pentax", "hasselblad", "iphone", "apple",
      "samsung", "google", "pixel", "dji", "gopro", "ricoh", "sigma", "kodak"
    ],
    "context_verbs": ["taken", "shot", "captured", "photographed"],
    "context_prepositions": ["with", "on", "using", "by"],
    "articles": ["a", "an", "my"],
    "suffixes": ["camera"]
  },

  "comparisons": {
    "greater": [
      "above", "over", "greater than", "more than", "higher than",
      "bigger than", "larger than", "greater", "higher", "bigger", "larger",
      ">"
    ],
    "greater_or_equal": [
      "at least", "no less than", "not less than", "minimum", "min", ">=", "=>"
    ],
    "less": [
      "below", "under", "less than", "lower than", "smaller than",
      "fewer than", "less", "lower", "smaller", "<"
    ],
    "less_or_equal": [
      "at most", "no more than", "not more than", "maximum", "max", "<=", "=<"
    ],
    "aperture_wider": ["wider than", "wider", "faster", "brighter", "more open"],
    "aperture_narrower": ["narrower than", "narrower", "smaller", "stopped down"],
    "shutter_faster": ["faster than", "faster", "quicker", "shorter than", "shorter"],
    "shutter_slower": ["slower than", "slower", "longer than", "longer"],
    "focal_longer": ["above", "over", "longer than", "greater than", "more than", ">"],
    "focal_shorter": ["below", "under", "shorter than", "less than", "<"]
  },

  "flash": {
    "on_phrases": ["with flash", "flash on", "flash fired", "using flash"],
    "off_phrases": ["without flash", "no flash", "flash off"]
  },

  "dates": {
    "months": [
      "january", "february", "march", "april", "may", "june",
      "july", "august", "september", "october", "november", "december"
    ],
    "ambiguous_months": ["may"],
    "prepositions": ["in", "from", "during"]
  },

  "location": {
    "prepositions": ["in", "at", "near", "around", "from"]
  },

  "file_types": {
    "raw": ["cr2", "cr3", "nef", "nrw", "arw", "raf", "orf", "rw2", "dng", "pef", "srw", "x3f"],
    "jpeg": ["jpg", "jpeg"],
    "png": ["png"],
    "heic": ["heic", "heif"],
    "tiff": ["tif", "tiff"],
    "video": ["mp4", "mov", "m4v", "avi", "mkv", "webm"]
  },

  "text": {
    "imperative_words": ["find", "show", "me", "all"],
    "filler_words": [
      "find", "show", "me", "all", "the", "a", "an", "my", "of",
      "photo", "photos", "picture", "pictures", "pic", "pics",
      "image", "images", "shot", "shots", "taken", "with", "and"
    ]
  }
}
