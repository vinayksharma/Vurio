#!/bin/zsh

set -euo pipefail

APP_DIR="$(cd "$(dirname "$0")" && pwd)"
BACKEND_DIR="${APP_DIR}/dedup_server"
SWIFT_UI_DIR="${APP_DIR}/swift_ui"
WEB_UI_DIR="${APP_DIR}/web_ui"

DO_REBUILD=false
START_WEB=false
TAIL_PID=""

# Stream the server's console log into this terminal, stripping ANSI/escape
# sequences. The server binary must never write to the terminal directly:
# raw bytes in its output (color codes, EXIF garbage) can contain the
# ESC[5i media-copy sequence, which iTerm2 interprets as "open the print
# dialog". run.sh redirects the server to logs/server_console.log; this
# tails that file through a sanitizer so the log stays visible AND safe.
stream_server_log() {
  local log_file="${BACKEND_DIR}/logs/server_console.log"
  touch "$log_file"
  echo "Streaming server log from ${log_file} (Ctrl+C stops everything)..."
  tail -n 0 -F "$log_file" 2>/dev/null \
    | LC_ALL=C sed -l $'s/\033\[[0-9;?]*[a-zA-Z]//g' \
    | LC_ALL=C tr -d '\000-\010\013\014\016-\037' &
  TAIL_PID=$!
}

stop_server_log_stream() {
  if [ -n "$TAIL_PID" ]; then
    kill "$TAIL_PID" 2>/dev/null || true
    TAIL_PID=""
  fi
}

cleanup() {
  echo -e "\n[restart] Caught shutdown signal. Running stopall to clean up..."
  stop_server_log_stream
  if [ -x "${BACKEND_DIR}/scripts/stopall" ]; then
    "${BACKEND_DIR}/scripts/stopall"
  fi
  exit 1
}

trap cleanup INT TERM

# Parse arguments using a while loop for long arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    -b)
      DO_REBUILD=true
      shift
      ;;
    -web)
      START_WEB=true
      shift
      ;;
    *)
      echo "Invalid option: $1" >&2
      exit 1
      ;;
  esac
done

echo "Stopping current instances..."
# Stop backend gracefully if possible
if [ -d "$BACKEND_DIR" ] && [ -x "${BACKEND_DIR}/scripts/run.sh" ]; then
  (cd "$BACKEND_DIR" && ./scripts/run.sh stop 2>/dev/null || true)
fi

# Find and kill Electron/Swift UI processes for this app
pkill -f "electron.*${APP_DIR}" 2>/dev/null || true
pkill -f "electron.*vurio" 2>/dev/null || true
pkill -f "electron.*main.js" 2>/dev/null || true
pkill -f "VURIO" 2>/dev/null || true
# Stale log-stream tails from a previous hard-killed restart
pkill -f "tail -n 0 -F ${BACKEND_DIR}/logs/server_console.log" 2>/dev/null || true

# Give it a moment to fully stop
sleep 1

if [ "$DO_REBUILD" = true ]; then
  echo "Rebuilding backend (-b flag provided)..."
  if [ -x "${BACKEND_DIR}/scripts/rebuild" ]; then
    (cd "${BACKEND_DIR}/scripts" && ./rebuild -c -t)
  else
    echo "Warning: rebuild script not found or not executable at ${BACKEND_DIR}/scripts/rebuild"
  fi
  
  if [ "$START_WEB" = true ]; then
    echo "Rebuilding web frontend..."
    if command -v bun &> /dev/null; then
      (cd "$WEB_UI_DIR" && bun run bun:build)
    else
      (cd "$WEB_UI_DIR" && npm run npm:build)
    fi
  else
    echo "Rebuilding Swift UI and running unit tests..."
    (cd "$SWIFT_UI_DIR" && swift build)
    echo "Starting backend temporarily for tests..."
    (cd "$BACKEND_DIR" && ./scripts/run.sh server)
    sleep 2
    set +e
    (cd "$SWIFT_UI_DIR" && swift test)
    TEST_EXIT_CODE=$?
    set -e
    echo "Stopping temporary backend..."
    (cd "$BACKEND_DIR" && ./scripts/run.sh stop)
    if [ $TEST_EXIT_CODE -ne 0 ]; then
      exit $TEST_EXIT_CODE
    fi
  fi
fi

if [ "$START_WEB" = true ]; then
  echo "--- Launching Legacy Web UI ---"
  echo "Starting Backend with Web Server..."
  (cd "$BACKEND_DIR" && ./scripts/run.sh server -web)
  
  echo "Starting Electron..."
  sleep 2
  stream_server_log
  if command -v bun &> /dev/null; then
    (cd "$WEB_UI_DIR" && NODE_ENV=production bun run electron)
  else
    (cd "$WEB_UI_DIR" && NODE_ENV=production npm run electron)
  fi
  stop_server_log_stream
else
  echo "--- Launching Native Swift UI ---"
  echo "Starting Backend (gRPC only)..."
  (cd "$BACKEND_DIR" && ./scripts/run.sh server)

  echo "Starting Swift UI..."
  sleep 2
  stream_server_log
  (cd "$SWIFT_UI_DIR" && swift run VURIO)
  stop_server_log_stream
fi
