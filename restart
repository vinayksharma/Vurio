#!/bin/zsh

set -euo pipefail

APP_DIR="$(cd "$(dirname "$0")" && pwd)"

echo "Stopping current Electron instance..."
# Find and kill Electron processes for this app
pkill -f "electron.*${APP_DIR}" 2>/dev/null || true
pkill -f "electron.*vurio" 2>/dev/null || true
pkill -f "electron.*main.js" 2>/dev/null || true
# Give it a moment to fully stop
sleep 1

echo "Building application..."
cd "$APP_DIR"

# Build and run Electron
if command -v bun &> /dev/null; then
  echo "Using Bun..."
  bun run bun:build && NODE_ENV=production bun run electron
else
  echo "Using npm..."
  npm run build && NODE_ENV=production npm run electron
fi
