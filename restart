#!/bin/zsh

set -euo pipefail

APP_DIR="$(cd "$(dirname "$0")" && pwd)"
DEDUP_SERVER_DIR="$APP_DIR/dedup_server"

# Check if dedup server is running (same check as dedup_server/scripts/stopall)
dedup_server_running() {
  [[ -n "$(pgrep -f media_dedup_server 2>/dev/null)" ]]
}

# If no dedup server instance is running, start it in a new terminal (so it stays up)
if ! dedup_server_running; then
  echo "No Media Deduplication Server running; starting dedup_server in a new terminal..."
  START_IN_TERMINAL="$DEDUP_SERVER_DIR/scripts/start_in_terminal.sh"
  if [[ -x "$START_IN_TERMINAL" ]]; then
    "$START_IN_TERMINAL"
    sleep 2
    if dedup_server_running; then
      echo "Dedup server started in new terminal."
    else
      echo "A new terminal was opened for the dedup server. It may still be starting."
    fi
  else
    echo "Warning: $START_IN_TERMINAL not found or not executable. Continuing anyway."
  fi
else
  echo "Dedup server already running."
fi

echo "Stopping current instance..."
# Find and kill Electron processes for this app
pkill -f "electron.*${APP_DIR}" 2>/dev/null || true
pkill -f "electron.*vurio" 2>/dev/null || true
pkill -f "electron.*main.js" 2>/dev/null || true
# Give it a moment to fully stop
sleep 1

echo "Building application..."
cd "$APP_DIR"

# Check if bun is available
if command -v bun &> /dev/null; then
  echo "Using Bun..."
  bun run bun:build
  echo "Starting application..."
  NODE_ENV=production bun run electron
else
  echo "Using npm..."
  npm run build
  echo "Starting application..."
  NODE_ENV=production npm run electron
fi
