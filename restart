#!/bin/zsh

set -euo pipefail

APP_DIR="$(cd "$(dirname "$0")" && pwd)"
BACKEND_DIR="${APP_DIR}/dedup_server"
SWIFT_UI_DIR="${APP_DIR}/swift_ui"
WEB_UI_DIR="${APP_DIR}/web_ui"

DO_REBUILD=false
START_WEB=false
TAIL_PID=""

# NOTHING this script runs writes to the terminal unfiltered. Raw bytes from
# the server, from the media pipeline, or from a test that prints either
# (color codes, EXIF garbage, file paths) can contain the ESC[5i media-copy
# sequence, which iTerm2 obeys by opening its print dialog — and printing.
#
# `sed` drops complete escape sequences; `tr` then drops every remaining
# control byte INCLUDING a bare ESC (\033 falls in \016-\037), so a sequence
# split across two writes cannot reassemble into a live one further down the
# pipe. Tab, newline and carriage return survive. Colour goes with it: the
# terminal staying under our control is worth more than green test output.
sanitize_tty() {
  LC_ALL=C sed -l $'s/\033\[[0-9;?]*[a-zA-Z]//g' \
    | LC_ALL=C tr -d '\000-\010\013\014\016-\037'
}

# Run a child with its output sanitized, preserving its exit status: `set -o
# pipefail` is on, and the filters cannot fail, so the pipeline's status is
# the child's.
run_sanitized() {
  "$@" 2>&1 | sanitize_tty
}

# Stream the server's console log into this terminal, sanitized. run.sh
# redirects the server to logs/server_console.log; this tails that file so
# the log stays visible AND safe.
stream_server_log() {
  local log_file="${BACKEND_DIR}/logs/server_console.log"
  touch "$log_file"
  echo "Streaming server log from ${log_file} (Ctrl+C stops this instance)..."
  # The sanitizer is a process substitution rather than a pipeline so that $!
  # is `tail` itself. In a pipeline $! is the LAST element (tr), and killing
  # that leaves the `tail -F` at the head alive — which used to force a
  # pattern-matching pkill on teardown. That pkill is not safe any more: with
  # several instances running, a pattern can match a sibling's tail.
  tail -n 0 -F "$log_file" 2>/dev/null > >(sanitize_tty) &
  TAIL_PID=$!
}

stop_server_log_stream() {
  if [ -n "$TAIL_PID" ]; then
    # Killing tail closes the pipe, so the sanitizer exits on EOF by itself.
    kill "$TAIL_PID" 2>/dev/null || true
    TAIL_PID=""
  fi
}

cleanup() {
  echo -e "\n[restart] Caught shutdown signal. Stopping this instance..."
  teardown_all
  exit 1
}

# Tear down what THIS script started, and nothing else: its log stream and its
# backend. Several server+UI pairs (one per worktree/branch) are meant to run
# side by side, so this must never reach for the machine-wide sweep — that is
# what ./killall is for, and only when a human asks for it.
#
# run.sh stop works off ${BACKEND_DIR}/dedup_server.pid, which is per-worktree,
# so it stops this instance's server alone. The UI needs no killing: it is a
# child of this script in the same foreground process group, so it has already
# received the same Ctrl+C, and on the non-signal paths it has already exited
# (that is what returned control to us).
teardown_all() {
  stop_server_log_stream
  if [ -d "$BACKEND_DIR" ] && [ -x "${BACKEND_DIR}/scripts/run.sh" ]; then
    (cd "$BACKEND_DIR" && ./scripts/run.sh stop 2>/dev/null || true)
  fi
}

# A failure once the backend is already up. The old flow ran the Swift tests
# against a throwaway backend it stopped straight afterwards, so a failure had
# nothing to clean up. Now that tests and UI share the ONE backend this script
# launches, a failure here would otherwise orphan a running server (and leave
# the next ./restart to kill it, an hour later, mid-whatever). Kill it, and put
# enough on the terminal to work out why without going digging.
fail_and_teardown() {
  local what="$1"
  local code="$2"
  local log_file="${BACKEND_DIR}/logs/server_console.log"

  echo ""
  echo "=================================================================="
  echo "[restart] FAILED: ${what} exited ${code}"
  echo "[restart] The backend was already running when this happened, so it"
  echo "[restart] is being shut down rather than left orphaned."
  echo "[restart] Server log: ${log_file}"
  if [ -f "$log_file" ]; then
    echo "------------------ last 40 lines of server log -------------------"
    # Same sanitizing as stream_server_log: raw server bytes must never reach
    # the terminal unfiltered (ESC[5i opens iTerm2's print dialog).
    tail -n 40 "$log_file" 2>/dev/null | sanitize_tty || true
  fi
  echo "=================================================================="
  echo ""

  teardown_all
  exit "$code"
}

trap cleanup INT TERM

# --- Replacing this worktree's previous instance ---------------------------
# A restart replaces the server+UI pair that THIS worktree (this branch)
# launched last time, and nothing else: pairs running from other worktrees keep
# going. A process is ours when its executable lives under APP_DIR (the VURIO
# binary in swift_ui/.build, the server in dedup_server/build — this also
# catches a UI or server someone started by hand from here), or when the
# environment it was started with carries this worktree's
# VURIO_INSTANCE_GROUP (`swift run`'s helper and anything else a previous
# ./restart forked). The previous ./restart shell itself is /bin/zsh and had
# not exported the group yet when it started, so it is recognised by its argv
# plus working directory instead.

# Executable path of a pid; empty if unreadable. lsof lists the program's
# own text segment first.
exe_of() {
  lsof -a -p "$1" -d txt -Fn 2>/dev/null | awk '/^n/ { print substr($0, 2); exit }'
}

cwd_of() {
  lsof -a -p "$1" -d cwd -Fn 2>/dev/null | awk '/^n/ { print substr($0, 2); exit }'
}

# The group is matched with a trailing delimiter so that a sibling worktree
# whose path merely extends ours (vurio vs vurio1) is never mistaken for us.
launched_by_this_worktree() {
  ps -E -o command= -p "$1" 2>/dev/null | sed 's/$/ /' | grep -qF " VURIO_INSTANCE_GROUP=${APP_DIR} "
}

is_ours() {
  local exe
  exe="$(exe_of "$1")"
  case "$exe" in
    "${APP_DIR}"/*) return 0 ;;
  esac
  launched_by_this_worktree "$1"
}

# pids matching an argv pattern (pgrep -f, ERE) that belong to this worktree.
ours_matching() {
  local pid
  for pid in $(pgrep -f "$1" 2>/dev/null || true); do
    is_self_lineage "$pid" && continue
    is_ours "$pid" && echo "$pid"
  done
  return 0
}

# True for this very script, anything it forked (zsh runs command
# substitutions in a child that keeps the same argv), and anything it was
# forked from (a `zsh -c './restart'` wrapper carries our name in its argv,
# and killing it would take us down too).
is_self_lineage() {
  local p="$1"
  while [ -n "$p" ] && [ "$p" -gt 1 ]; do
    [ "$p" = "$$" ] && return 0
    p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
  done
  p="$$"
  while [ -n "$p" ] && [ "$p" -gt 1 ]; do
    [ "$p" = "$1" ] && return 0
    p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
  done
  return 1
}

# Earlier ./restart shells (and their subshells) for this worktree: argv is
# exactly `/bin/zsh <…/>restart [flags]`, from the shebang, and the working
# directory is this worktree.
previous_restart_shells() {
  local pid
  for pid in $(pgrep -f '^/bin/zsh ([^ ]*/)?restart( |$)' 2>/dev/null || true); do
    is_self_lineage "$pid" && continue
    [ "$(cwd_of "$pid")" = "$APP_DIR" ] && echo "$pid"
  done
  return 0
}

alive() {
  local pid
  for pid in "$@"; do
    kill -0 "$pid" 2>/dev/null && return 0
  done
  return 1
}

# Waits up to $1 seconds for the remaining pids to exit; returns 1 if any
# survived.
wait_for_exit() {
  local seconds="$1"; shift
  local waited=0
  while alive "$@" && [ "$waited" -lt "$seconds" ]; do
    sleep 1
    waited=$((waited + 1))
  done
  ! alive "$@"
}

# Signals $2.. with $1, waits, then SIGKILLs whatever is left.
stop_pids() {
  local signal="$1"; shift
  [ $# -eq 0 ] && return 0
  kill "-${signal}" "$@" 2>/dev/null || true
  if ! wait_for_exit 10 "$@"; then
    echo "[restart]   still running after ${signal}, forcing: $*"
    kill -KILL "$@" 2>/dev/null || true
    wait_for_exit 3 "$@" || true
  fi
}

stop_previous_instance() {
  echo "Stopping the previous instance from this worktree (if any)..."
  # pid lists are newline-separated; ${=var} splits them into words (zsh
  # does not split unquoted parameters by default).
  local shells uis servers tails pid pgid stopped_any=false
  shells=$(previous_restart_shells)
  uis=$(ours_matching 'VURIO')
  servers=$(ours_matching 'media_dedup_server')

  # 1. A previous ./restart is still attached to its pair. Give it the
  #    Ctrl+C it would have got from its own terminal — its cleanup trap then
  #    stops its log stream and its server in the usual way — and wait for
  #    it to finish, so its teardown cannot race the pair we are about to
  #    start (both would read the same dedup_server.pid). Launched from a
  #    terminal, the script leads its own process group, and interrupting
  #    the group reaches the UI it is waiting on; launched some other way it
  #    shares a group with a parent we must not touch, so the UI is
  #    interrupted by pid instead.
  if [ -n "$shells" ]; then
    stopped_any=true
    for pid in ${=shells}; do
      pgid=$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ' || true)
      if [ -n "$pgid" ] && [ "$pgid" = "$pid" ]; then
        echo "[restart]   interrupting previous ./restart (pid ${pid}, process group ${pgid})"
        kill -INT -- "-${pgid}" 2>/dev/null || true
      else
        echo "[restart]   interrupting previous ./restart (pid ${pid})"
        kill -INT "$pid" 2>/dev/null || true
        [ -n "$uis" ] && kill -INT ${=uis} 2>/dev/null || true
      fi
    done
    if ! wait_for_exit 30 ${=shells}; then
      echo "[restart]   previous ./restart did not finish its teardown; forcing"
      kill -KILL ${=shells} 2>/dev/null || true
    fi
  fi

  # 2. Whatever is left of ours: a UI started by hand, a server whose restart
  #    was hard-killed, a stale pid file. UIs first so nothing reconnects to
  #    a server mid-shutdown; then the pid-file route (graceful, and it clears
  #    the file), then any server of ours the pid file did not know about.
  uis=$(ours_matching 'VURIO')
  if [ -n "$uis" ]; then
    stopped_any=true
    echo "[restart]   stopping UI process(es): $(echo $uis | tr '\n' ' ')"
    stop_pids TERM ${=uis}
  fi
  if [ -f "${BACKEND_DIR}/dedup_server.pid" ] && [ -x "${BACKEND_DIR}/scripts/run.sh" ]; then
    (cd "$BACKEND_DIR" && ./scripts/run.sh stop >/dev/null 2>&1 || true)
  fi
  servers=$(ours_matching 'media_dedup_server')
  if [ -n "$servers" ]; then
    stopped_any=true
    echo "[restart]   stopping server process(es): $(echo $servers | tr '\n' ' ')"
    stop_pids TERM ${=servers}
  fi
  tails=$(pgrep -f "tail -n 0 -F ${BACKEND_DIR}/logs/server_console\.log" 2>/dev/null || true)
  if [ -n "$tails" ]; then
    kill ${=tails} 2>/dev/null || true
  fi

  local leftover
  leftover="$(ours_matching 'VURIO|media_dedup_server')"
  if [ -n "$leftover" ]; then
    echo "[restart] WARNING: could not stop: $(echo $leftover | tr '\n' ' ')"
  elif [ "$stopped_any" = true ]; then
    echo "[restart]   previous instance stopped."
  else
    echo "[restart]   none running."
  fi
}

# Parse arguments using a while loop for long arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    -b)
      DO_REBUILD=true
      shift
      ;;
    -web)
      START_WEB=true
      shift
      ;;
    *)
      echo "Invalid option: $1" >&2
      exit 1
      ;;
  esac
done

# Only THIS worktree's previous instance is stopped on the way in (see
# stop_previous_instance, run right before the new pair launches). This script
# used to open by killing every server and every UI on the machine, which made
# a second instance impossible: starting one from another worktree tore down
# the one already running. Each invocation now owns exactly the server and UI
# it launches, and several can run at once. The UI finds its server through
# the broker (BROKER-1): it pairs only with a free server built from its own
# commit, and prefers the one carrying the same VURIO_INSTANCE_GROUP — this
# worktree — over an equally matching one started elsewhere. Use ./killall for
# a machine-wide sweep after something has crashed.
export VURIO_INSTANCE_GROUP="${APP_DIR}"
echo "Starting a new instance from ${APP_DIR}..."

if [ "$DO_REBUILD" = true ]; then
  # Runtime models first, and only then the build. models/ and extensions/
  # are gitignored, so a fresh worktree has none of them, and the CMake
  # build's own fallback for a missing CLIP model was a 99-byte placeholder
  # text file — a server that starts cleanly and then fails to embed every
  # image. ensure_models.sh downloads whatever is missing (or copies it from
  # VURIO_MODELS_FROM=<another checkout>/dedup_server/models) and exits
  # non-zero rather than let a placeholder through; set -e then stops us
  # here, before anything is built or the running pair is touched.
  echo "Ensuring runtime models are present..."
  run_sanitized "${BACKEND_DIR}/scripts/ensure_models.sh"

  echo "Rebuilding backend (-b flag provided)..."
  if [ -x "${BACKEND_DIR}/scripts/rebuild" ]; then
    # Sanitized like the server log, and for the same reason: the suite runs
    # the media pipeline, so its output carries file paths and EXIF strings
    # straight from the test corpus. -b is the only flag that puts those
    # bytes on the terminal, which is why the print dialog only ever appeared
    # on a -b run.
    run_sanitized zsh -c "cd '${BACKEND_DIR}/scripts' && ./rebuild -c -t"
  else
    echo "Warning: rebuild script not found or not executable at ${BACKEND_DIR}/scripts/rebuild"
  fi
  
  if [ "$START_WEB" = true ]; then
    echo "Rebuilding web frontend..."
    if command -v bun &> /dev/null; then
      (cd "$WEB_UI_DIR" && bun run bun:build)
    else
      (cd "$WEB_UI_DIR" && npm run npm:build)
    fi
  else
    echo "Rebuilding Swift UI..."
    (cd "$SWIFT_UI_DIR" && swift build)
    # The Swift tests used to run here against a backend started and stopped
    # just for them — two extra server lifecycles for what is a single
    # read-only GetStatus smoke test. Worse, that throwaway process still ran
    # the server's one-time startup work: on 2026-08-15 it stamped the edge
    # discovery epoch and cleared discovery_done on 143,124 rows, then took
    # SIGTERM one second later, leaving the real backend to sweep for 3h45m
    # with nothing recording that a repair was in flight. The tests now run
    # against the single backend launched below.
  fi
fi

# The previous pair keeps running through the build above, so a failed build
# leaves it in place; it is replaced only once there is something to launch.
stop_previous_instance

if [ "$START_WEB" = true ]; then
  echo "--- Launching Legacy Web UI ---"
  echo "Starting Backend with Web Server..."
  (cd "$BACKEND_DIR" && ./scripts/run.sh server -web)
  
  echo "Starting Electron..."
  sleep 2
  stream_server_log
  set +e
  if command -v bun &> /dev/null; then
    (cd "$WEB_UI_DIR" && NODE_ENV=production bun run electron)
  else
    (cd "$WEB_UI_DIR" && NODE_ENV=production npm run electron)
  fi
  UI_EXIT_CODE=$?
  set -e
  if [ $UI_EXIT_CODE -ne 0 ]; then
    fail_and_teardown "electron" $UI_EXIT_CODE
  fi
  # This instance's server goes down with its UI. Nothing kills it on the way
  # into the next run any more, so leaving it up would orphan it for good.
  teardown_all
else
  echo "--- Launching Native Swift UI ---"
  echo "Starting Backend (gRPC only)..."
  (cd "$BACKEND_DIR" && ./scripts/run.sh server)

  sleep 2
  # Streaming starts before the tests so server-side activity during the run is
  # on screen next to the test output.
  stream_server_log

  if [ "$DO_REBUILD" = true ]; then
    echo "Running Swift UI unit tests against the running backend..."
    set +e
    # These tests pair with the running server and print what it sends back
    # (registered and ejected directory paths), so their output is server
    # bytes too — sanitized on the way out like everything else.
    run_sanitized zsh -c "cd '$SWIFT_UI_DIR' && swift test"
    TEST_EXIT_CODE=$?
    set -e
    if [ $TEST_EXIT_CODE -ne 0 ]; then
      fail_and_teardown "swift test" $TEST_EXIT_CODE
    fi
    echo "Swift UI unit tests passed."
  fi

  echo "Starting Swift UI..."
  set +e
  (cd "$SWIFT_UI_DIR" && swift run VURIO)
  UI_EXIT_CODE=$?
  set -e
  if [ $UI_EXIT_CODE -ne 0 ]; then
    fail_and_teardown "swift run VURIO" $UI_EXIT_CODE
  fi
  # See above: the server this invocation started is stopped with its UI.
  teardown_all
fi
