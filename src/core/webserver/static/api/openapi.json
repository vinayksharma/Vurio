{
  "openapi": "3.0.0",
  "info": {
    "title": "Media Deduplication Server API",
    "version": "1.0.0",
    "description": "Configuration, User Settings, and TPM API. Interactive documentation available at the root endpoint (/) via Swagger UI."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Development server"
    }
  ],
  "paths": {
    "/api/v1/config": {
      "get": {
        "summary": "Get all configuration properties",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/config/{key}": {
      "get": {
        "summary": "Get a specific configuration property",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Property not found"
          }
        }
      },
      "put": {
        "summary": "Update a configuration property",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  }
                },
                "required": ["value"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Property updated successfully"
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/api/v1/config/reload": {
      "post": {
        "summary": "Reload configuration from file",
        "responses": {
          "200": {
            "description": "Configuration reloaded successfully"
          },
          "500": {
            "description": "Failed to reload configuration"
          }
        }
      }
    },
    "/api/v1/server/status": {
      "get": {
        "summary": "Get comprehensive server status",
        "description": "Returns server status including scanned files count, registered directories, configuration status, and thread pool information",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "server_name": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "scanned_files_count": {
                      "type": "integer"
                    },
                    "processed_files_count": {
                      "type": "integer"
                    },
                    "error_files_count": {
                      "type": "integer"
                    },
                    "queued_files_count": {
                      "type": "integer"
                    },
                    "duplicates_found": {
                      "type": "integer",
                      "description": "Total count of all files across all duplicate groups"
                    },
                    "duplicate_groups": {
                      "type": "integer",
                      "description": "Number of duplicate groups"
                    },
                    "files_with_duplicates": {
                      "type": "integer",
                      "description": "Count of distinct files that have duplicates"
                    },
                    "registered_directories": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "registered_directories_count": {
                      "type": "integer"
                    },
                    "configuration": {
                      "type": "object",
                      "properties": {
                        "valid": {
                          "type": "boolean"
                        },
                        "config_file": {
                          "type": "string"
                        },
                        "property_count": {
                          "type": "integer"
                        },
                        "validation_errors": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "thread_pool": {
                      "type": "object",
                      "properties": {
                        "effective_max_threads": {
                          "type": "integer"
                        },
                        "running_total": {
                          "type": "integer"
                        },
                        "per_type": {
                          "type": "object"
                        }
                      }
                    },
                    "timestamp": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/user-settings": {
      "get": {
        "summary": "List all user settings",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/user-settings/{key}": {
      "get": {
        "summary": "Get a specific user setting",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Setting not found"
          }
        }
      },
      "put": {
        "summary": "Create or update a user setting",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  }
                },
                "required": ["value"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Setting updated successfully"
          },
          "201": {
            "description": "Setting created successfully"
          }
        }
      },
      "delete": {
        "summary": "Delete a user setting",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Setting deleted successfully"
          },
          "404": {
            "description": "Setting not found"
          }
        }
      }
    },
    "/api/v1/media-locations/register": {
      "post": {
        "summary": "Register a media location",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "directory": {
                    "type": "string"
                  }
                },
                "required": ["directory"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Location registered successfully"
          }
        }
      }
    },
    "/api/v1/media-locations/deregister": {
      "post": {
        "summary": "Deregister a media location",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "directory": {
                    "type": "string"
                  }
                },
                "required": ["directory"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Location deregistered successfully"
          }
        }
      }
    },
    "/api/v1/duplicates/groups": {
      "get": {
        "summary": "Get paginated duplicate groups with members",
        "description": "Returns duplicate groups with representative and candidate files (all as fully qualified paths), sorted by created_at ascending. Optionally filter by detection mode.",
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "description": "Starting index (0-based offset)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of groups to return (max: 1000)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "mode",
            "in": "query",
            "description": "Filter by detection mode (FAST or QUALITY). Omit to return all modes.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["FAST", "QUALITY"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Duplicate groups retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "groups": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "description": "Duplicate group ID"
                          },
                          "mode": {
                            "type": "string",
                            "description": "Detection mode (FAST or QUALITY)"
                          },
                          "representative": {
                            "type": "string",
                            "description": "Fully qualified path to representative file"
                          },
                          "candidates": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Fully qualified paths to duplicate candidate files"
                          },
                          "similarity_threshold": {
                            "type": "number",
                            "description": "Similarity threshold used for this group"
                          },
                          "member_count": {
                            "type": "integer",
                            "description": "Total number of members in this group"
                          },
                          "created_at": {
                            "type": "string",
                            "description": "ISO 8601 timestamp when group was created"
                          },
                          "updated_at": {
                            "type": "string",
                            "description": "ISO 8601 timestamp when group was last updated"
                          }
                        }
                      }
                    },
                    "total_count": {
                      "type": "integer",
                      "description": "Total number of duplicate groups in database"
                    },
                    "start": {
                      "type": "integer",
                      "description": "Starting index of this page"
                    },
                    "end": {
                      "type": "integer",
                      "description": "Ending index (start + limit)"
                    },
                    "returned": {
                      "type": "integer",
                      "description": "Actual number of groups returned in this page"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/duplicates/reset": {
      "delete": {
        "summary": "Reset duplicate detection for all modes or specific mode",
        "description": "Clears duplicate groups and resets duplicate detection checkpoint while preserving all processed artifacts (scanned files, phash, features, embeddings). This allows re-running duplicate detection with new thresholds or algorithms without re-processing media files.",
        "parameters": [
          {
            "name": "mode",
            "in": "query",
            "description": "Specific mode to reset (FAST, BALANCED, or QUALITY). Omit to reset ALL modes.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["FAST", "BALANCED", "QUALITY"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reset completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid mode parameter",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "error": {
                      "type": "string",
                      "example": "Invalid mode parameter. Must be FAST, BALANCED, or QUALITY"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/thumbnails": {
      "get": {
        "summary": "Generate or retrieve thumbnail for a source image",
        "description": "Returns a thumbnail image for the specified source file. Generates on-demand if not cached, returns cached version if available and valid. Supports all image formats including RAW files (ARW, CR2, NEF, etc.).",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "description": "Fully qualified path to source image file",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "Thumbnail size (width/height of longest edge)",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [128, 256, 512, 1024],
              "default": 256
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Thumbnail image (JPEG)",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            },
            "headers": {
              "Content-Type": {
                "schema": {
                  "type": "string",
                  "example": "image/jpeg"
                }
              },
              "Content-Length": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "400": {
            "description": "Bad request (invalid parameters)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Source file not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error (generation failed)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/thumbnails/cleanup": {
      "delete": {
        "summary": "Clean up orphaned thumbnail cache entries",
        "description": "Removes cached thumbnails for source files that no longer exist. Useful for reclaiming disk space after deleting source images.",
        "responses": {
          "200": {
            "description": "Cleanup completed (not yet implemented)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/files/reset-errors": {
      "post": {
        "summary": "Reset all error files to unprocessed",
        "description": "Resets all files with error status (< 0) to unprocessed (0) for the current server mode, allowing them to be retried",
        "responses": {
          "200": {
            "description": "Errors reset successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the operation was successful"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed"
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Swagger UI - Interactive API Documentation",
        "description": "Serves the Swagger UI interface for interactive API testing and documentation",
        "responses": {
          "200": {
            "description": "Swagger UI HTML page",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
