{
  "openapi": "3.0.0",
  "info": {
    "title": "Media Deduplication Server API",
    "version": "1.0.0",
    "description": "Configuration, User Settings, and TPM API. Interactive documentation available at the root endpoint (/) via Swagger UI."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Development server"
    }
  ],
  "paths": {
    "/api/v1/config": {
      "get": {
        "summary": "Get all configuration properties",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/config/{key}": {
      "get": {
        "summary": "Get a specific configuration property",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Property not found"
          }
        }
      },
      "put": {
        "summary": "Update a configuration property",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  }
                },
                "required": ["value"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Property updated successfully"
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/api/v1/config/reload": {
      "post": {
        "summary": "Reload configuration from file",
        "responses": {
          "200": {
            "description": "Configuration reloaded successfully"
          },
          "500": {
            "description": "Failed to reload configuration"
          }
        }
      }
    },
    "/api/v1/server/status": {
      "get": {
        "summary": "Get comprehensive server status",
        "description": "Returns server status including scanned files count, registered directories, configuration status, and thread pool information",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "server_name": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "scanned_files_count": {
                      "type": "integer"
                    },
                    "processed_files_count": {
                      "type": "integer"
                    },
                    "error_files_count": {
                      "type": "integer"
                    },
                    "queued_files_count": {
                      "type": "integer"
                    },
                    "duplicates_found": {
                      "type": "integer",
                      "description": "Total count of all files across all duplicate groups"
                    },
                    "duplicate_groups": {
                      "type": "integer",
                      "description": "Number of duplicate groups"
                    },
                    "files_with_duplicates": {
                      "type": "integer",
                      "description": "Count of distinct files that have duplicates"
                    },
                    "registered_directories": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "registered_directories_count": {
                      "type": "integer"
                    },
                    "configuration": {
                      "type": "object",
                      "properties": {
                        "valid": {
                          "type": "boolean"
                        },
                        "config_file": {
                          "type": "string"
                        },
                        "property_count": {
                          "type": "integer"
                        },
                        "validation_errors": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "thread_pool": {
                      "type": "object",
                      "properties": {
                        "effective_max_threads": {
                          "type": "integer"
                        },
                        "running_total": {
                          "type": "integer"
                        },
                        "per_type": {
                          "type": "object"
                        }
                      }
                    },
                    "timestamp": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/user-settings": {
      "get": {
        "summary": "List all user settings",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/user-settings/{key}": {
      "get": {
        "summary": "Get a specific user setting",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Setting not found"
          }
        }
      },
      "put": {
        "summary": "Create or update a user setting",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  }
                },
                "required": ["value"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Setting updated successfully"
          },
          "201": {
            "description": "Setting created successfully"
          }
        }
      },
      "delete": {
        "summary": "Delete a user setting",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Setting deleted successfully"
          },
          "404": {
            "description": "Setting not found"
          }
        }
      }
    },
    "/api/v1/media-locations/register": {
      "post": {
        "summary": "Register a media location",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "directory": {
                    "type": "string"
                  }
                },
                "required": ["directory"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Location registered successfully"
          }
        }
      }
    },
    "/api/v1/media-locations/deregister": {
      "post": {
        "summary": "Deregister a media location",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "directory": {
                    "type": "string"
                  }
                },
                "required": ["directory"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Location deregistered successfully"
          }
        }
      }
    },
    "/api/v1/files/reset-errors": {
      "post": {
        "summary": "Reset all error files to unprocessed",
        "description": "Resets all files with error status (< 0) to unprocessed (0) for the current server mode, allowing them to be retried",
        "responses": {
          "200": {
            "description": "Errors reset successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the operation was successful"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed"
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Swagger UI - Interactive API Documentation",
        "description": "Serves the Swagger UI interface for interactive API testing and documentation",
        "responses": {
          "200": {
            "description": "Swagger UI HTML page",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
