{
  "openapi": "3.0.0",
  "info": {
    "title": "Media Deduplication Server API",
    "version": "1.0.0",
    "description": "Configuration, User Settings, and TPM API. Interactive documentation available at the root endpoint (/) via Swagger UI."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Development server"
    }
  ],
  "paths": {
    "/api/v1/config": {
      "get": {
        "summary": "Get all configuration properties",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/config/{key}": {
      "get": {
        "summary": "Get a specific configuration property",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Property not found"
          }
        }
      },
      "put": {
        "summary": "Update a configuration property",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  }
                },
                "required": ["value"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Property updated successfully"
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/api/v1/config/reload": {
      "post": {
        "summary": "Reload configuration from file",
        "responses": {
          "200": {
            "description": "Configuration reloaded successfully"
          },
          "500": {
            "description": "Failed to reload configuration"
          }
        }
      }
    },
    "/api/v1/server/status": {
      "get": {
        "summary": "Get comprehensive server status",
        "description": "Returns server status including scanned files count, registered directories, configuration status, and thread pool information",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "server_name": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "scanned_files_count": {
                      "type": "integer"
                    },
                    "processed_files_count": {
                      "type": "integer"
                    },
                    "error_files_count": {
                      "type": "integer"
                    },
                    "queued_files_count": {
                      "type": "integer"
                    },
                    "duplicates_found": {
                      "type": "integer",
                      "description": "Total count of all files across all duplicate groups"
                    },
                    "duplicate_groups": {
                      "type": "integer",
                      "description": "Number of duplicate groups"
                    },
                    "files_with_duplicates": {
                      "type": "integer",
                      "description": "Count of distinct files that have duplicates"
                    },
                    "registered_directories": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "registered_directories_count": {
                      "type": "integer"
                    },
                    "configuration": {
                      "type": "object",
                      "properties": {
                        "valid": {
                          "type": "boolean"
                        },
                        "config_file": {
                          "type": "string"
                        },
                        "property_count": {
                          "type": "integer"
                        },
                        "validation_errors": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "thread_pool": {
                      "type": "object",
                      "properties": {
                        "effective_max_threads": {
                          "type": "integer"
                        },
                        "running_total": {
                          "type": "integer"
                        },
                        "per_type": {
                          "type": "object"
                        }
                      }
                    },
                    "timestamp": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/user-settings": {
      "get": {
        "summary": "List all user settings",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/user-settings/{key}": {
      "get": {
        "summary": "Get a specific user setting",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Setting not found"
          }
        }
      },
      "put": {
        "summary": "Create or update a user setting",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  }
                },
                "required": ["value"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Setting updated successfully"
          },
          "201": {
            "description": "Setting created successfully"
          }
        }
      },
      "delete": {
        "summary": "Delete a user setting",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Setting deleted successfully"
          },
          "404": {
            "description": "Setting not found"
          }
        }
      }
    },
    "/api/v1/media-locations/register": {
      "post": {
        "summary": "Register a media location",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "directory": {
                    "type": "string"
                  }
                },
                "required": ["directory"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Location registered successfully"
          }
        }
      }
    },
    "/api/v1/media-locations/deregister": {
      "post": {
        "summary": "Deregister a media location",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "directory": {
                    "type": "string"
                  }
                },
                "required": ["directory"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Location deregistered successfully"
          }
        }
      }
    },
    "/api/v1/media-locations/change-path": {
      "post": {
        "summary": "Change a registered media location path",
        "description": "Verifies the new path by sampling files and updates all associated file paths in the database",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "old_path": {
                    "type": "string",
                    "description": "Current registered scan path"
                  },
                  "new_path": {
                    "type": "string",
                    "description": "New scan path to change to"
                  },
                  "sample_size": {
                    "type": "integer",
                    "description": "Number of files to verify (default: 20)",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 20
                  }
                },
                "required": ["old_path", "new_path"]
              },
              "example": {
                "old_path": "/Volumes/OldDrive/Photos",
                "new_path": "/Volumes/NewDrive/Photos",
                "sample_size": 20
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Path changed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ok", "partial_success", "error"]
                    },
                    "old_path": {
                      "type": "string"
                    },
                    "new_path": {
                      "type": "string"
                    },
                    "files_verified": {
                      "type": "integer",
                      "description": "Number of files sampled for verification"
                    },
                    "files_verified_success": {
                      "type": "integer",
                      "description": "Number of files that verified successfully"
                    },
                    "total_files": {
                      "type": "integer",
                      "description": "Total number of files associated with the old location"
                    },
                    "files_updated": {
                      "type": "integer",
                      "description": "Number of files successfully updated"
                    },
                    "files_failed": {
                      "type": "integer",
                      "description": "Number of files that failed to update"
                    },
                    "verification_success_rate": {
                      "type": "number",
                      "format": "double",
                      "description": "Success rate of verification (0.0 to 1.0)"
                    },
                    "update_details": {
                      "type": "object",
                      "description": "Per-table update statistics",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "updated": {
                            "type": "integer"
                          },
                          "failed": {
                            "type": "integer"
                          }
                        }
                      }
                    },
                    "error": {
                      "type": "string",
                      "description": "Error message if status is error or partial_success"
                    }
                  }
                },
                "example": {
                  "status": "ok",
                  "old_path": "/Volumes/OldDrive/Photos",
                  "new_path": "/Volumes/NewDrive/Photos",
                  "files_verified": 20,
                  "files_verified_success": 20,
                  "total_files": 1500,
                  "files_updated": 1500,
                  "files_failed": 0,
                  "verification_success_rate": 1.0,
                  "update_details": {
                    "scanned_files": {"updated": 1500, "failed": 0},
                    "image_artifacts": {"updated": 1200, "failed": 0},
                    "processing_errors": {"updated": 50, "failed": 0},
                    "duplicate_groups": {"updated": 30, "failed": 0},
                    "duplicate_members": {"updated": 200, "failed": 0},
                    "thumbnail_cache": {"updated": 800, "failed": 0}
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or verification failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string"},
                    "error": {"type": "string"}
                  }
                }
              }
            }
          },
          "404": {
            "description": "Old path not registered or no files found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string"},
                    "error": {"type": "string"}
                  }
                }
              }
            }
          },
          "500": {
            "description": "Database update failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string"},
                    "error": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/duplicates/groups": {
      "get": {
        "summary": "Get paginated duplicate groups with detailed member information",
        "description": "Returns duplicate groups with representative and all members including similarity scores, file sizes, and metadata. Members are sorted by similarity score (highest first). Optionally filter by detection mode.",
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "description": "Starting index (0-based offset)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of groups to return (max: 1000)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "mode",
            "in": "query",
            "description": "Filter by detection mode (FAST or QUALITY). Omit to return all modes.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["FAST", "QUALITY"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Duplicate groups retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "groups": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "description": "Duplicate group ID"
                          },
                          "mode": {
                            "type": "string",
                            "description": "Detection mode (FAST or QUALITY)"
                          },
                          "representative": {
                            "type": "string",
                            "description": "Fully qualified path to representative file"
                          },
                          "members": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "file_path": {
                                  "type": "string",
                                  "description": "Fully qualified path to the file"
                                },
                                "similarity_score": {
                                  "type": "number",
                                  "description": "Similarity score to the representative (0.0-1.0)"
                                },
                                "file_size": {
                                  "type": "integer",
                                  "description": "File size in bytes"
                                },
                                "created_date": {
                                  "type": "string",
                                  "description": "File creation date"
                                },
                                "is_representative": {
                                  "type": "boolean",
                                  "description": "Whether this file is the group representative"
                                },
                                "added_at": {
                                  "type": "string",
                                  "description": "ISO 8601 timestamp when this member was added to the group"
                                }
                              }
                            },
                            "description": "All members of the duplicate group with detailed information"
                          },
                          "similarity_threshold": {
                            "type": "number",
                            "description": "Similarity threshold used for this group"
                          },
                          "member_count": {
                            "type": "integer",
                            "description": "Total number of members in this group"
                          },
                          "created_at": {
                            "type": "string",
                            "description": "ISO 8601 timestamp when group was created"
                          },
                          "updated_at": {
                            "type": "string",
                            "description": "ISO 8601 timestamp when group was last updated"
                          }
                        }
                      }
                    },
                    "total_count": {
                      "type": "integer",
                      "description": "Total number of duplicate groups in database"
                    },
                    "start": {
                      "type": "integer",
                      "description": "Starting index of this page"
                    },
                    "end": {
                      "type": "integer",
                      "description": "Ending index (start + limit)"
                    },
                    "returned": {
                      "type": "integer",
                      "description": "Actual number of groups returned in this page"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/duplicates/reset": {
      "delete": {
        "summary": "Reset duplicate detection for EMBEDDING mode",
        "description": "Clears duplicate groups and resets duplicate detection checkpoint while preserving all processed artifacts (scanned files, embeddings). This allows re-running duplicate detection with new thresholds without re-processing media files.",
        "parameters": [
          {
            "name": "mode",
            "in": "query",
            "description": "Specific mode to reset (only EMBEDDING is supported). Omit to reset EMBEDDING mode (default).",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["EMBEDDING"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reset completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid mode parameter",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "error": {
                      "type": "string",
                      "example": "Invalid mode parameter. Only EMBEDDING mode is supported"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/thumbnails": {
      "get": {
        "summary": "Generate or retrieve thumbnail for a source image",
        "description": "Returns a thumbnail image for the specified source file. Generates on-demand if not cached, returns cached version if available and valid. Supports all image formats including RAW files (ARW, CR2, NEF, etc.).",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "description": "Fully qualified path to source image file",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "Thumbnail size (width/height of longest edge)",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [128, 256, 512, 1024],
              "default": 256
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Thumbnail image (JPEG)",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            },
            "headers": {
              "Content-Type": {
                "schema": {
                  "type": "string",
                  "example": "image/jpeg"
                }
              },
              "Content-Length": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "400": {
            "description": "Bad request (invalid parameters)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Source file not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error (generation failed)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/thumbnails/cleanup": {
      "delete": {
        "summary": "Clean up orphaned thumbnail cache entries",
        "description": "Removes cached thumbnails for source files that no longer exist. Useful for reclaiming disk space after deleting source images.",
        "responses": {
          "200": {
            "description": "Cleanup completed (not yet implemented)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assets/jpeg": {
      "get": {
        "summary": "Return a JPEG for a given asset path (served from cache)",
        "description": "Always serves from cache. If not cached or stale, generates a JPEG from the source (including RAW) and stores it under cache.assetPreview.location. No CORS/auth for now (same-machine).",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Fully qualified path to the asset"
          },
          {
            "name": "maxWidth",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1 },
            "description": "Maximum width in pixels. If omitted, no resize (highest resolution)."
          },
          {
            "name": "quality",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 85 },
            "description": "JPEG quality (1-100). Defaults from config."
          }
        ],
        "responses": {
          "200": {
            "description": "JPEG image",
            "content": {
              "image/jpeg": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "400": { "description": "Bad request" },
          "404": { "description": "Source file not found" },
          "415": { "description": "Unsupported media type" },
          "500": { "description": "Generation failed (returns error JPEG)" }
        }
      }
    },
    "/api/v1/files/reset-errors": {
      "post": {
        "summary": "Reset all error files to unprocessed",
        "description": "Resets all files with error status (< 0) to unprocessed (0) for the current server mode, allowing them to be retried",
        "responses": {
          "200": {
            "description": "Errors reset successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the operation was successful"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed"
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Swagger UI - Interactive API Documentation",
        "description": "Serves the Swagger UI interface for interactive API testing and documentation",
        "responses": {
          "200": {
            "description": "Swagger UI HTML page",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
